# Firebase (Spark / Blaze) — create a project and enable Firestore + Storage.
# Generate a service account key: Project settings → Service accounts → Generate new private key.

# Bucket name from Firebase console → Storage (usually project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Paste the entire service account JSON as ONE line. Must include "type":"service_account",
# "private_key", and "client_email" — NOT the web app config (apiKey / appId).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Docker Compose loads this file via env_file so `$` inside JSON is not mangled.

# Option: mount the JSON file and set path inside the container instead of the line above:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-adminsdk.json
